pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'my56k8s.jfrog.io'
        IMAGE_NAME = 'ci-pipeline-app'
        IMAGE_TAG = "${env.BUILD_NUMBER}-${params.COMMIT.take(7)}"
    }

    parameters {
        string(name: 'BRANCH', defaultValue: 'main', description: 'Git branch')
        string(name: 'COMMIT', defaultValue: '', description: 'Commit hash')
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "${params.BRANCH}",
                    url: 'https://github.com/turkardiksha345-oss/docker-ci-with-jenkins-jfrog.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh """
                docker build -t $IMAGE_NAME:$IMAGE_TAG ./docker
                docker tag $IMAGE_NAME:$IMAGE_TAG $DOCKER_REGISTRY/$IMAGE_NAME:$IMAGE_TAG
                docker tag $IMAGE_NAME:$IMAGE_TAG $DOCKER_REGISTRY/$IMAGE_NAME:latest
                """
            }
        }

        stage('Push to JFrog') {
            steps {
                sh """
                echo $JFROG_PASSWORD | docker login $DOCKER_REGISTRY -u $JFROG_USER --password-stdin
                docker push $DOCKER_REGISTRY/$IMAGE_NAME:$IMAGE_TAG
                docker push $DOCKER_REGISTRY/$IMAGE_NAME:latest
                """
            }
        }
    }

    post {
        success {
            echo "✅ Image pushed to JFrog successfully"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}