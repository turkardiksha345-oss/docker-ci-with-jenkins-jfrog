pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'my56k8s.jfrog.io/sample-docker-local'
        IMAGE_NAME      = 'ci-pipeline-app'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "main",
                    url: 'https://github.com/turkardiksha345-oss/docker-ci-with-jenkins-jfrog.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                docker build -t $IMAGE_NAME:$IMAGE_TAG -f docker/Dockerfile .
                docker tag $IMAGE_NAME:$IMAGE_TAG $DOCKER_REGISTRY/$IMAGE_NAME:$IMAGE_TAG
                docker tag $IMAGE_NAME:$IMAGE_TAG $DOCKER_REGISTRY/$IMAGE_NAME:latest
                '''
            }
        }

        stage('Push to JFrog') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'jfrog-creds',
                    usernameVariable: 'JFROG_USER',
                    passwordVariable: 'JFROG_PASSWORD'
                )]) {
                    sh '''
                    echo $JFROG_PASSWORD | docker login my56k8s.jfrog.io -u $JFROG_USER --password-stdin
                    docker push $DOCKER_REGISTRY/$IMAGE_NAME:$IMAGE_TAG
                    docker push $DOCKER_REGISTRY/$IMAGE_NAME:latest
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Image pushed to JFrog successfully"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}